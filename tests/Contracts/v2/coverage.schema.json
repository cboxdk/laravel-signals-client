{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cboxsignals.com/v2/coverage.schema.json",
  "title": "Signals v2 coverage",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "coverage"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "position": {
      "$ref": "#/$defs/position"
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "event_time": {
      "$ref": "#/$defs/coverage"
    },
    "commit_through": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "expected_families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 100
    },
    "observed_families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 100
    },
    "omitted_records": {
      "type": "integer",
      "minimum": 0
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "contract_version",
    "kind",
    "scope",
    "position",
    "emitted_at",
    "event_time",
    "commit_through",
    "expected_families",
    "observed_families",
    "omitted_records",
    "completeness",
    "reason_codes"
  ],
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audience": {
          "enum": [
            "tenant",
            "environment"
          ]
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "project_id",
        "environment_id",
        "audience"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audience": {
                "const": "tenant"
              }
            }
          },
          "then": {
            "required": [
              "tenant_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "tenant_id"
              ]
            }
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "partition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        }
      },
      "required": [
        "source_id",
        "partition",
        "generation",
        "sequence"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "missing",
            "stale",
            "unsupported",
            "warming"
          ]
        },
        "from": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "through": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expected_cadence_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "lag_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "status",
        "from",
        "through",
        "expected_cadence_seconds",
        "lag_seconds",
        "reasons"
      ],
      "additionalProperties": false
    }
  }
}
